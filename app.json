{
  "expo": {
    "name": "foreverfind",
    "slug": "foreverfind",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "foreverfind",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.bardsai.foreverfind",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/logo-mark.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0F0B15",
            "image": "./assets/images/logo-mark-dark.png"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ForeverFind uses your location to show you people nearby and respect your distance preference."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ForeverFind needs access to your photos so you can add a profile picture.",
          "cameraPermission": "ForeverFind needs access to your camera so you can take a profile picture.",
          "microphonePermission": false
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0212d262-ed9f-47e4-b840-1c9be5bb8205"
      }
    },
    "owner": "bardsai",
    "ios": {
      "bundleIdentifier": "com.bardsai.foreverfind",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    }
  }
}
